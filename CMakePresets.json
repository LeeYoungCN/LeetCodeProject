{
    "version": 3,
    "configurePresets": [
        {
            "name": "project-base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "description": "项目基础设置",
            "cacheVariables": {
                "PROBLEM_PREFIX": "all"
            }
        },
        {
            "name": "mingw-base",
            "hidden": true,
            "generator": "MinGW Makefiles",
            "inherits": "project-base",
            "toolchainFile": "${sourceDir}/cmake/mingw.cmake",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "D:/Programs/MinGW/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "D:/Programs/MinGW/bin/g++.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "mingw_debug",
            "displayName": "Mingw Debug Configure",
            "inherits": "mingw-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mingw_release",
            "displayName": "Mingw Release Configure",
            "inherits": "mingw-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux_base",
            "hidden": true,
            "generator": "Unix Makefiles",
            "inherits": "project-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux_gnu_base",
            "hidden": true,
            "inherits": "linux_base",
            "toolchainFile": "${sourceDir}/cmake/linux_gnu.cmake",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++"
            }
        },
        {
            "name": "linux_gnu_debug",
            "displayName": "Linux GNU Debug Configure",
            "inherits": "linux_gnu_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux_gnu_release",
            "displayName": "Linux GNU Release Configure",
            "inherits": "linux_gnu_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux_clang_base",
            "hidden": true,
            "inherits": "linux_base",
            "toolchainFile": "${sourceDir}/cmake/linux_clang.cmake",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/home/ly/tools/clang/bin/clang",
                "CMAKE_CXX_COMPILER": "/home/ly/tools/clang/bin/clang++"
            }
        },
        {
            "name": "linux_clang_debug",
            "displayName": "Linux Clang Debug Configure",
            "inherits": "linux_clang_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux_clang_release",
            "displayName": "Linux Clang Release Configure",
            "inherits": "linux_clang_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "darwin_base",
            "hidden": true,
            "generator": "Unix Makefiles",
            "inherits": "project-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "darwin_clang_base",
            "hidden": true,
            "inherits": "darwin_base",
            "toolchainFile": "${sourceDir}/cmake/drawin_clang.cmake",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "darwin_clang_debug",
            "displayName": "Darwin Clang Debug Configure",
            "inherits": "darwin_clang_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "darwin_clang_release",
            "displayName": "Darwin Clang Release Configure",
            "inherits": "darwin_clang_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "mingw_debug",
            "configurePreset": "mingw_debug",
            "displayName": "MinGW Debug Build",
            "description": "Build the MinGW Debug configuration",
            "targets":["all", "install"],
            "jobs": 4
        },
        {
            "name": "mingw_release",
            "configurePreset": "mingw_release",
            "displayName": "MinGW Release Build",
            "description": "Build the MinGW Release configuration",
            "targets":["all", "install"],
            "jobs": 4
        },
        {
            "name": "linux_clang_debug",
            "configurePreset": "linux_clang_debug",
            "displayName": "Linux Clang Debug Build",
            "description": "Build the Linux Clang Debug configuration",
            "targets":["all", "install"],
            "jobs": 4
        },
        {
            "name": "linux_clang_release",
            "configurePreset": "linux_clang_release",
            "displayName": "Linux Clang Release Build",
            "description": "Build the Linux Clang Release configuration",
            "targets":["all", "install"],
            "jobs": 4
        },
        {
            "name": "linux_gnu_debug",
            "configurePreset": "linux_gnu_debug",
            "displayName": "Linux GNU Debug Build",
            "description": "Build the Linux GNU Debug configuration",
            "targets":["all", "install"],
            "jobs": 4
        },
        {
            "name": "linux_gnu_release",
            "configurePreset": "linux_gnu_release",
            "displayName": "Linux GNU Release Build",
            "description": "Build the Linux GNU Release configuration",
            "targets":["all", "install"],
            "jobs": 4
        }
    ]
}