{
    "version": 3,
    "configurePresets": [
        {
            "name": "project-base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "description": "项目基础设置"
        },
        {
            "name": "mingw-base",
            "hidden": true,
            "generator": "MinGW Makefiles",
            "inherits": "project-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "D:/Programs/MinGW/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "D:/Programs/MinGW/bin/g++.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "mingw_debug",
            "displayName": "Mingw Debug",
            "inherits": "mingw-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mingw_release",
            "displayName": "Mingw Release",
            "inherits": "mingw-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux_base",
            "hidden": true,
            "generator": "Unix Makefiles",
            "inherits": "project-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux_gnu_base",
            "hidden": true,
            "inherits": "linux_base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++"
            }
        },
        {
            "name": "linux_gnu_debug",
            "displayName": "Linux GNU Debug",
            "inherits": "linux_gnu_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux_gnu_release",
            "displayName": "Linux GNU Release",
            "inherits": "linux_gnu_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux_clang_base",
            "hidden": true,
            "inherits": "linux_base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/home/ly/tools/clang/bin/clang",
                "CMAKE_CXX_COMPILER": "/home/ly/tools/clang/bin/clang++"
            }
        },
        {
            "name": "linux_clang_debug",
            "displayName": "Linux Clang Debug",
            "inherits": "linux_clang_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux_clang_release",
            "displayName": "Linux Clang Release",
            "inherits": "linux_clang_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "darwin_base",
            "hidden": true,
            "generator": "Unix Makefiles",
            "inherits": "project-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "darwin_clang_base",
            "hidden": true,
            "inherits": "darwin_base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "darwin_clang_debug",
            "displayName": "Darwin Clang Debug",
            "inherits": "darwin_clang_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "darwin_clang_release",
            "displayName": "Darwin Clang Release",
            "inherits": "darwin_clang_base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}