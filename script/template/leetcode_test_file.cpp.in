};

void @TEST_CLASSNAME@::SetUp()
{
    m_testList.push_back(new @CLASS_NAME@());
}

void @TEST_CLASSNAME@::TearDown()
{
    for (@CLASS_NAME@ *inst : m_testList) {
        delete inst;
    }
}

void @TEST_CLASSNAME@::RunTest(@TEST_CLASSNAME@_Params params)
{
    @FUNC_RET_TYPE@ expect = params.expect;
    for (@CLASS_NAME@ *inst : m_testList) {
        @FUNC_RET_TYPE@ result = inst->@CLASS_FUNC@(@PARAM_NAMES@);
        @EXPECT_EQ_CODE@
    }
}

