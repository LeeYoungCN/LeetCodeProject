#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <deque>
#include <functional>
#include <map>
#include <queue>
#include <set>
#include <stack>
#include <string>
#include <unordered_map>
#include <unordered_set>
#include <vector>

#include "gtest/gtest.h"
#include "@HEAD_FILE_NAME@"
#include "leetcode_utils_vector.hpp"
#include "leetcode_utils_list.hpp"

using namespace std;

class @TEST_CLASSNAME@_Params {
public:
    @TEST_CLASSNAME@_Params() = default;

    @TEST_CLASSNAME@_Params(@TEST_CASE_INIT_PARAMS@){};

    ~@TEST_CLASSNAME@_Params()
    {
        freeMemberParams_();
    };

    @TEST_CLASSNAME@_Params(const @TEST_CLASSNAME@_Params& other)
    {
        copyMemberParams_(other);
    }

    @TEST_CLASSNAME@_Params &operator=(const @TEST_CLASSNAME@_Params &other)
    {
        if (this == &other) {
            return *this;
        }
        freeMemberParams_();
        copyMemberParams_(other);
        return *this;
    }

    friend std::ostream &operator<<(std::ostream &os, const @TEST_CLASSNAME@_Params &params)
    {
        os << "refCnt: " << params.refCnt->load() << std::endl;
        os << "Print params";
        return os;
    };

public:
    @TEST_CASE_VAR@;
    @FUNC_RET_TYPE@ expect{};

private:
    std::atomic<int32_t> *refCnt = new std::atomic<int32_t>(1);

private:
    void freeMemberParams_()
    {
        int32_t oldCnt = refCnt->fetch_sub(1, std::memory_order_relaxed);
        if (oldCnt == 1) {
            /* Free */
            std::cout << "refCnt: " << refCnt->load();
        }
    }

    void copyMemberParams_(const @TEST_CLASSNAME@_Params &other)
    {
        refCnt = other.refCnt;
        refCnt->fetch_add(1, std::memory_order_relaxed);
        /* Copy */
        std::cout << "refCnt: " << refCnt->load();
    }
};

class @TEST_CLASSNAME@ : public ::testing::TestWithParam<@TEST_CLASSNAME@_Params> {
protected:
    static void SetUpTestSuite() {}
    static void TearDownTestSuite() {}
    void SetUp() override;
    void TearDown() override;

    vector<@CLASS_NAME@ *> m_testList;
};

void @TEST_CLASSNAME@::SetUp()
{
    m_testList.push_back(new @CLASS_NAME@());
}

void @TEST_CLASSNAME@::TearDown()
{
    for (@CLASS_NAME@ *inst : m_testList) {
        delete inst;
    }
}

TEST_P(@TEST_CLASSNAME@, case)
{
    @TEST_CLASSNAME@_Params params = GetParam();
    @FUNC_RET_TYPE@ expect = params.expect;
    for (@CLASS_NAME@ *inst : m_testList) {
        @FUNC_RET_TYPE@ result = inst->@CLASS_FUNC@(@PARAM_NAMES@);
        @EXPECT_EQ_CODE@
    }
}

INSTANTIATE_TEST_SUITE_P(, @TEST_CLASSNAME@, ::testing::Values(@TEST_CLASSNAME@_Params(@TEST_CASE_INIT_PARAMS@)));
