{
    "version": "2.0.0",
    "type": "shell",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "Build",
            "options": {
                "cwd": "${workspaceFolder}/script/"
            },
            "command": "${workspaceFolder}/script/build.sh",
            "args": [
                "-c"
            ],
            "detail": "根据makefile生成可执行文件和库文件",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Rebuild",
            "options": {
                "cwd": "${workspaceFolder}/script/"
            },
            "command": "${workspaceFolder}/script/build.sh",
            "args": [],
            "detail": "根据makefile生成可执行文件和库文件",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Rebuild & Run",
            "options": {
                "cwd": "${workspaceFolder}/script/"
            },
            "command": "${workspaceFolder}/script/build.sh",
            "args": [
                "-t",
                "\"*\""
            ],
            "detail": "根据makefile生成可执行文件和库文件",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}